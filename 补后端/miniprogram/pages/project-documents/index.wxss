.fd-documents{overflow-wrap:anywhere;word-break:break-all}.fd-documents button,.fd-documents .picker{min-height:44px;white-space:normal;line-height:1.6;padding:10px;box-sizing:border-box}.fd-documents .label{margin-top:12px}.fd-pages{display:flex;flex-wrap:wrap;gap:8px}.fd-pages button{flex:1;min-width:0}.fd-reference-count,.fd-reference-row{color:#1d4ed8;background:#eff6ff;text-align:left}.fd-reference-list{border-top:1px solid #dbeafe;padding-top:10px}.fd-document,.fd-document view{min-width:0;max-width:100%}
