.fd-resources{background:#eff6ff;padding:12px;border-radius:10px;overflow-wrap:anywhere;word-break:break-all;min-width:0}.fd-title{font-weight:600;line-height:1.8}.fd-group{background:#fff;padding:12px;margin-top:12px;border:1px solid #dbeafe;border-radius:8px;min-width:0}.fd-group button,.fd-filter{box-sizing:border-box;min-height:44px;font-size:14px;line-height:1.5;padding:10px;white-space:normal;margin:6px 0;overflow-wrap:anywhere}.fd-group input{width:100%;box-sizing:border-box;min-height:44px;padding:8px;border:1px solid #cbd5e1;border-radius:5px;font-size:14px;margin:6px 0}.fd-filter{border:1px solid #cbd5e1}.fd-hint{font-size:13px;line-height:1.8;color:#64748b}.fd-error{color:#b91c1c;font-size:13px;line-height:1.8}.fd-record{padding:10px 0;border-bottom:1px solid #e2e8f0}.fd-link{color:#1d4ed8;text-align:left}.fd-pages{display:flex;flex-wrap:wrap;gap:8px}.fd-pages button{flex:1;min-width:0}
