.fd-body,.fd-node,.fd-file{min-width:0;max-width:100%;overflow-wrap:anywhere;word-break:break-all}.fd-text{white-space:pre-wrap;line-height:1.8}.fd-editable{min-height:44px;border:1px dashed #cbd5e1;border-radius:6px;padding:8px;margin:8px 0;box-sizing:border-box}.fd-body textarea{width:100%;box-sizing:border-box;min-height:110px;padding:10px;border:1px solid #2563eb;border-radius:6px;line-height:1.8}.fd-body button{min-height:44px;white-space:normal;line-height:1.5;font-size:14px;padding:10px;margin:4px 0;overflow-wrap:anywhere}.fd-link{color:#1d4ed8;background:#eff6ff;text-align:left}.fd-error{color:#b91c1c;white-space:pre-wrap;line-height:1.6;font-size:13px}.fd-tools{display:flex;flex-wrap:wrap;gap:8px}.fd-tools button{flex:1;min-width:0}.fd-file{padding:6px 0}
