page { background:#F0F5FF; color:#1F2937; font-family:-apple-system,"PingFang SC",sans-serif; font-size:28rpx; }
.container { padding:28rpx; padding-bottom:100rpx; }
.hero { padding:28rpx; background:#1E3A5F; color:#fff; border-radius:20rpx; margin-bottom:24rpx; }
.title { font-size:40rpx; font-weight:600; margin-bottom:12rpx; }
.card { background:#fff; border-radius:18rpx; padding:24rpx; margin-bottom:22rpx; }
.label { font-weight:600; margin-bottom:14rpx; display:block; }
.muted { color:#6B7280; font-size:25rpx; line-height:1.7; }
.warning { background:#FEF3C7; color:#92400E; padding:22rpx; border-radius:14rpx; margin:16rpx 0; line-height:1.7; }
.error { color:#B91C1C; white-space:pre-wrap; line-height:1.7; }
input, textarea, .picker { box-sizing:border-box; border:1rpx solid #D1D5DB; border-radius:12rpx; padding:18rpx; background:#fff; width:100%; }
input { min-height:90rpx; }
textarea { min-height:150rpx; margin-top:10rpx; }
button { font-size:28rpx; border-radius:12rpx; margin:14rpx 0; }
button.primary { color:#fff; background:#2563EB; }
button.small { font-size:24rpx; padding:0 20rpx; display:inline-block; margin-right:14rpx; }
.row { display:flex; justify-content:space-between; align-items:center; gap:16rpx; }
.grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.badge { color:#2563EB; font-size:24rpx; background:#EFF6FF; padding:8rpx 12rpx; border-radius:8rpx; }
.photo { width:100%; height:330rpx; background:#F3F4F6; margin:10rpx 0; border-radius:12rpx; }
.pre { white-space:pre-wrap; line-height:1.8; word-break:break-all; }
.diary-record .diary-meta { margin-top:28rpx; line-height:1.7; word-break:break-all; }
.diary-record .diary-hint { margin-top:16rpx; }
.diary-record .diary-guide { background:#EFF6FF; border:1rpx solid #DBEAFE; line-height:1.8; }
.diary-record .diary-guide .label { color:#1D4ED8; }
.diary-record textarea { min-height:220rpx; line-height:1.7; }
.diary-record .row .label { flex:1; min-width:0; }
.diary-record .row button { flex-shrink:0; }
.log-record .log-inspection { min-height:620rpx; }
