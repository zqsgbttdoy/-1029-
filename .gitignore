# ============================================================
# 监理现场管理系统 - Git 忽略规则
# 目的：只上传源码 / 配置 / 文档，排除本地缓存、构建产物、
#       依赖包、运行期数据与日志，避免仓库膨胀与敏感信息泄露。
# ============================================================

# ---------- 本地 Maven 依赖缓存（约 90MB，属于下载缓存，不入库） ----------
.m2-cache/

# ---------- 构建产物 ----------
# Maven 打包输出（jar/war/classes），可用 mvn package 重新生成
**/target/
# 前端/发布打包输出目录
dist/
# 一键打包生成的发布产物
*.jar
*.war
*.zip

# ---------- 随项目附带的 Maven 发行版 / 本地仓库（可重新下载） ----------
**/apache-maven-*/
**/.mvn/maven/

# ---------- Node 依赖（可用 npm install 还原） ----------
**/node_modules/

# ---------- 日志 ----------
logs/
*.log

# ---------- 运行期用户上传文件（非源码，测试/生产数据盘内容） ----------
uploads/
**/uploads/

# 本地手工测试数据库、附件及完整迁移备份
/local-data/
*.mv.db
*.trace.db
/scripts/migration-build/

# ---------- 本地密钥 / 环境变量（只保留 *.example 模板，真实值不入库） ----------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# ---------- 操作系统 / 编辑器临时文件 ----------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.tmp.cjs

# ---------- 真实浏览器验收产物：Edge 用户配置目录（数百 MB，含本机浏览数据） ----------
/测试工作区/.edge-visual-profile*/
/test-workspace-backup-*/

# ---------- 验收截图 / 运行输出 / 重置备份 / 导出样例（测试产物，不入库） ----------
/测试工作区/**/*.png
/测试工作区/**/*.jpg
/测试工作区/**/*-运行输出*.txt
/测试工作区/probe-*.txt
/测试工作区/probe-*.json
/测试工作区/reset/
/测试工作区/word-export-sample/
/测试工作区/补后端/
/测试工作区/qa22-uploads/
/测试工作区/factory-reset-backup-*/
/测试工作区/QA*/
/测试工作区/--security/
/测试工作区/--work-standard-only/
/测试工作区/multi-project-*/
/测试工作区/precheck-*/
/测试工作区/全面验证-*/
/测试工作区/权限成员*-20261026/
/测试工作区/前端适配核对-20261023/
/测试工作区/通知单附件验证-*/
/测试工作区/安全日志视觉验收/
/测试工作区/巡检旁站逐字段验收/
/测试工作区/监理日志视觉验收/
/测试工作区/监理日记视觉验收/
/测试工作区/记录页窄屏回归/
/测试工作区/*.txt
/*.txt
